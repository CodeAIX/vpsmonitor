FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
ARG TARGETOS TARGETARCH TARGETVARIANT
ARG PLUS_VERSION=dev
ARG PLUS_COMMIT=unknown
RUN if [ "$TARGETARCH" = "arm" ] && [ -n "$TARGETVARIANT" ]; then export GOARM="${TARGETVARIANT#v}"; fi; \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags "-w -s -X github.com/CodeAIX/vpsmonitor.BuildVersion=${PLUS_VERSION} -X github.com/CodeAIX/vpsmonitor.BuildCommit=${PLUS_COMMIT}" -o /agent ./internal/cmd/agent

# The original scratch image remains unchanged. This explicit variant provides
# only the vnStat CLI; it does not run a second collector daemon.
FROM alpine:3.24@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a
ARG PLUS_VERSION=dev
ARG PLUS_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/CodeAIX/vpsmonitor" \
      org.opencontainers.image.version="$PLUS_VERSION" \
      org.opencontainers.image.revision="$PLUS_COMMIT" \
      org.opencontainers.image.licenses="MIT"
RUN apk add --no-cache ca-certificates vnstat && \
    mkdir -p /var/lib/vpsmonitor-agent && chmod 0770 /var/lib/vpsmonitor-agent
COPY --from=builder /agent /agent
COPY --from=builder /app/agent/test-data/amdgpu.ids /usr/share/libdrm/amdgpu.ids
VOLUME ["/var/lib/vpsmonitor-agent"]
ENTRYPOINT ["/agent"]
