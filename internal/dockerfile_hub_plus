FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
ARG TARGETOS TARGETARCH
ARG PLUS_VERSION=dev
ARG PLUS_COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags "-w -s -X github.com/CodeAIX/vpsmonitor.BuildVersion=${PLUS_VERSION} -X github.com/CodeAIX/vpsmonitor.BuildCommit=${PLUS_COMMIT}" -o /vpsmonitor ./internal/cmd/hub

FROM scratch
ARG PLUS_VERSION=dev
ARG PLUS_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/CodeAIX/vpsmonitor" \
      org.opencontainers.image.version="$PLUS_VERSION" \
      org.opencontainers.image.revision="$PLUS_COMMIT" \
      org.opencontainers.image.licenses="MIT"
COPY --from=builder /vpsmonitor /vpsmonitor
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
VOLUME ["/beszel_data"]
EXPOSE 8090
ENTRYPOINT ["/vpsmonitor"]
CMD ["serve", "--http=0.0.0.0:8090"]
