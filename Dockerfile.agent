FROM --platform=$BUILDPLATFORM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS TARGETARCH
ARG VERSION=0.1.0-dev COMMIT=unknown
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags "-s -w -X github.com/CodeAIX/vpsmonitor.BuildVersion=${VERSION} -X github.com/CodeAIX/vpsmonitor.BuildCommit=${COMMIT}" -o /agent ./internal/cmd/agent

FROM alpine:3.24@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a
ARG VERSION=0.1.0-dev COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/CodeAIX/vpsmonitor" org.opencontainers.image.version="$VERSION" org.opencontainers.image.revision="$COMMIT"
RUN apk add --no-cache ca-certificates && mkdir -p /var/lib/vpsmonitor-agent && chmod 0700 /var/lib/vpsmonitor-agent
COPY --from=build /agent /agent
ENV DATA_DIR=/var/lib/vpsmonitor-agent
VOLUME ["/var/lib/vpsmonitor-agent"]
COPY LICENSE NOTICE /usr/share/licenses/vpsmonitor/
ENTRYPOINT ["/agent"]
